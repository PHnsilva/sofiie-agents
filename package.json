{
  "name": "sofiie-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orquestração local de especialistas, conhecimento revisado e integração MCP para o Sofiie.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx src/evals/run.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run eval && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agents": "tsx src/cli.ts agents",
    "plan": "tsx src/cli.ts plan",
    "consult": "tsx src/cli.ts consult",
    "peer": "tsx src/cli.ts peer",
    "mcp": "node dist/mcp/stdio.js",
    "diagrams:setup": "node scripts/setup-plantuml.mjs",
    "diagram": "tsx src/modeling/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
