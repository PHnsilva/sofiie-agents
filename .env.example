# O runtime lê variáveis do ambiente. Este arquivo é apenas referência.
# Modo padrão: handoff (instruções para um assistente externo, sem inferência).
SOFIIE_PROVIDER=handoff
# Para inferência real, instale Ollama e escolha um modelo LOCAL já baixado.
# SOFIIE_PROVIDER=ollama
# SOFIIE_MODEL=nome-exato-do-modelo-local
# Configure também OLLAMA_NO_CLOUD=1 no processo/serviço do Ollama e reinicie-o.
# O adaptador usa apenas http://127.0.0.1:11434 e verifica a presença em /api/tags.
